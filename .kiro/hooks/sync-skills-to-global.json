{
  "name": "Sync to Global",
  "version": "1.0.0",
  "description": "Copies workspace skills and steering files to ~/.kiro/ for global availability",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "runCommand",
    "command": "powershell -NoProfile -Command \"Copy-Item -Recurse -Force .kiro/skills/* $HOME/.kiro/skills/; Copy-Item -Force .kiro/steering/arc-workflow.md $HOME/.kiro/steering/arc-workflow.md\""
  }
}
